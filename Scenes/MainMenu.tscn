[sub_resource type="Shader" id="Shader_outline"]
code = "shader_type canvas_item;

// Cream sticker outline so the logo stands out on the dark menu.
uniform vec4 outline_color : source_color = vec4(1.0, 0.94, 0.86, 1.0);
uniform float width = 6.0;

void fragment() {
	vec4 col = texture(TEXTURE, UV);
	float a = 0.0;
	for (int i = 0; i < 16; i++) {
		vec2 dir = vec2(cos(float(i) * 0.3927), sin(float(i) * 0.3927)) * TEXTURE_PIXEL_SIZE * width;
		a = max(a, texture(TEXTURE, UV + dir).a);
		a = max(a, texture(TEXTURE, UV + dir * 0.5).a);
	}
	COLOR = mix(vec4(outline_color.rgb, outline_color.a * a), col, col.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_outline"]
shader = SubResource("Shader_outline")

